# .dev.env — параметры проекта 1С (генерация кода + опционально модели)
# НЕ коммитить. Создаётся install.ps1 из этого шаблона.
# Подключение к ИБ — в .v8-project.json (отдельный файл, guard-проверки).

# --- Генерация кода ---
PREFIX=
COMPANY=
DEVELOPER=
PLATFORM_VERSION=8.3.27
PLATFORM_PATH=
NEW_OBJECTS_IN=osnova

# --- Модели субагентов (опционально; пусто = модель по умолчанию) ---
SUBAGENT_MODEL_CODING=
SUBAGENT_MODEL_ANALYSIS=
SUBAGENT_MODEL_LIGHT=

# --- Оркестрация (опционально) ---
ORCHESTRATION=standard

# --- Triage (опционально) ---
QUICKFIX_MAX_LINES=40
