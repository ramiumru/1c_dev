# Не устанавливается автоматически. При необходимости перенесите выбранные параметры
# в .codex/config.toml проекта или в ~/.codex/config.toml пользователя.
# CLI и расширение VS Code используют общие слои конфигурации.
# Модель выбирается пользователем; действующие настройки установщик не меняет.
# model = "<доступная-в-вашем-аккаунте-модель>"

approval_policy = "on-request"
sandbox_mode = "workspace-write"

# Современные клиенты обнаруживают .codex/agents/*.toml автоматически.
# Не включайте инструменты вопреки настройкам своей сессии.
# [agents]
# enabled = true

# AGENTS.md читается автоматически; отдельная [instructions] не требуется.
# https://learn.chatgpt.com/docs/config-file/config-basic
